#!/bin/bash
# Map tmux panes to the Claude Code sessions running in them.
#
# Run as tmux-resurrect's post-save-layout hook. Claude records no tty or pid
# in its transcripts, so the pane->session link only exists while the process
# is alive. Claude Code keeps a record of each running process,
# ~/.claude/sessions/<pid>.json, whose sessionId follows /resume and /branch;
# we take the pid's tty from ps and join to panes on it. The record is Claude
# Code's own, not a documented interface: if it changes, nothing is mapped and
# a restore types nothing. Needs jq.
#
# Writes "<session>:<window>.<pane>\t<session-id>\t<cwd>" beside the state file.
#
# Kept to bash 3.2 (no associative arrays): macOS ships only that.

set -uo pipefail

resurrect_file="${1:-}"
if [ -z "$resurrect_file" ]; then
	echo "usage: $(basename "$0") <resurrect-state-file>" >&2
	exit 1
fi

# "<tty> <session-id>" for every live Claude process. A record whose pid is
# gone, or now another program's (left by a crash), is skipped.
claude_sessions_by_tty() {
	local record pid sid tty comm
	for record in "$HOME"/.claude/sessions/*.json; do
		[ -f "$record" ] || continue
		read -r pid sid < <(jq -r '"\(.pid // "") \(.sessionId // "")"' "$record" 2>/dev/null) || continue
		read -r tty comm < <(ps -p "$pid" -o tty=,comm= 2>/dev/null) || continue
		[ "${comm##*/}" = claude ] && [ -n "$sid" ] && [ "$tty" != "??" ] || continue
		printf '%s %s\n' "$tty" "$sid"
	done
}

map_file="$(dirname "$resurrect_file")/claude_sessions.txt"

tmpfile="$(mktemp "${TMPDIR:-/tmp}/claude_sessions.XXXXXX")" || exit 1
trap 'rm -f "$tmpfile"' EXIT
chmod 600 "$tmpfile"

sessions="$(claude_sessions_by_tty)"
if [ -n "$sessions" ]; then
	while IFS=$'\t' read -r pane_id pane_tty pane_path; do
		[ -n "$pane_id" ] || continue
		sid="$(printf '%s\n' "$sessions" | awk -v t="${pane_tty#/dev/}" '$1 == t { print $2; exit }')"
		[ -n "$sid" ] || continue
		printf '%s\t%s\t%s\n' "$pane_id" "$sid" "$pane_path" >> "$tmpfile"
	done < <(tmux list-panes -a -F '#{session_name}:#{window_index}.#{pane_index}	#{pane_tty}	#{pane_current_path}')
fi

mv "$tmpfile" "$map_file"
trap - EXIT
