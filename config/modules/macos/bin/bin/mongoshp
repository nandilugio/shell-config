#!/bin/bash
set -euo pipefail

if [ $# -lt 1 ]; then
  echo "usage: ${0##*/} <target> [mongosh args...]" >&2
  exit 2
fi

target=$1
shift

mongo_url=$(security find-generic-password -s mongo -a "$target" -w 2>/dev/null) || {
  echo "${0##*/}: no keychain entry for service 'mongo', account '$target'" >&2
  exit 1
}

if [ -z "$mongo_url" ]; then
  echo "${0##*/}: empty password in keychain for service 'mongo', account '$target'" >&2
  exit 1
fi

mongosh "$mongo_url" "$@"
